name: Yak

on:
  schedule:
    - cron: '0 0,12 * * *'
  workflow_dispatch:

jobs:
  run-yak-main:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install Dependencies
      run: |
        python -m pip install --upgrade pip
        pip install requests

    - name: Decrypt Files
      env:
        SCRIPT_PASSPHRASE: ${{ secrets.SCRIPT_PASSPHRASE }}
      run: |
        gpg --quiet --batch --yes --decrypt --passphrase="$SCRIPT_PASSPHRASE" --output yak.py yak.py.gpg
        gpg --quiet --batch --yes --decrypt --passphrase="$SCRIPT_PASSPHRASE" --output yak.txt yak.txt.gpg

    - name: Run Script (Main)
      env:
        DISCORD_YAK: ${{ secrets.DISCORD_YAK }}
      run: |
        python yak.py > /dev/null 2>&1

    - name: Cleanup Secrets and Logs
      if: always()
      run: |
        rm -f yak.py yak.txt
        echo "Cleanup completed successfully."

  notify-completion:
    needs: [run-yak-main]
    if: always() && !cancelled()
    runs-on: ubuntu-latest
    steps:
    - name: Send Final Discord Message
      env:
        DISCORD_YAK: ${{ secrets.DISCORD_YAK }}
      run: |
        if [ -z "$DISCORD_YAK" ]; then
          exit 0
        fi
        
        LOCAL_TIME=$(TZ='Asia/Jakarta' date +'%Y-%m-%d %H:%M:%S')
        
        PAYLOAD=$(cat <<EOF
        {
          "content": "--------------------------------------------------\n:white_check_mark: **Done Process Yakkamon**\n:calendar_spiral: Date/Time: $LOCAL_TIME (UTC+7)\n--------------------------------------------------"
        }
        EOF
        )
        
        curl -s -X POST -H "Content-Type: application/json" -d "$PAYLOAD" "$DISCORD_YAK"
